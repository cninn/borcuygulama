{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/customers/:id", "destination": "/api/customers/[id]" },
    { "source": "/api/notes/:id",     "destination": "/api/notes/[id]" },
    { "source": "/api/(.*)",          "destination": "/api/$1" },
    { "source": "/(.*)",              "destination": "/index.html" }
  ]
}
